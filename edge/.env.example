# Copiar para /home/pi/catraca/.env no Pi e preencher.
CATRACA_CLOUD_URL=https://SEU-APP.onrender.com
CATRACA_CLOUD_API_KEY=troque-pela-key-do-render
CATRACA_FRAME_WIDTH=1280
CATRACA_FRAME_HEIGHT=720
CATRACA_OCR_CONF_THRESHOLD=0.85
CATRACA_COOLDOWN_S=10
CATRACA_MOTION_THRESHOLD=0.02
# Fallback LLM (opcional): requer conta pessoal na Anthropic
CATRACA_FALLBACK_ENABLED=0
# ANTHROPIC_API_KEY=sk-ant-...
# Botão físico de autorização no GPIO23 (opcional)
CATRACA_BUTTON_ENABLED=0
# Preview da câmera no navegador: http://<ip-do-pi>:8088 (0 desliga)
CATRACA_PREVIEW_PORT=8088
